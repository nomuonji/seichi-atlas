---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Contact" description="Contact Seichi Atlas: corrections, takedown requests, or feedback.">
  <section class="section">
    <div class="container prose">
      <p class="micro">Contact</p>
      <h1 class="display-lg" style="margin:.7rem 0 1rem;">Get in touch</h1>
      <p class="lede">
        Spot a wrong coordinate, a closed site, or an etiquette gap? Tell us. Corrections move fast
        here; the database is only as good as its last check.
      </p>

      <h2>What to use for what</h2>
      <ul>
        <li><strong>Corrections &amp; reports</strong>: contact@seichiatlas.com</li>
        <li><strong>Rights &amp; takedowns</strong>: rights@seichiatlas.com (we respond without argument)</li>
        <li><strong>Partnerships / tourism boards</strong>: hello@seichiatlas.com</li>
      </ul>

      <p class="mono" style="color:var(--text-faint); font-size:.8rem;">
        We do not respond to route-export waitlist requests here; use the form on /route.
      </p>

      <p>
        <a class="btn btn--primary" href="mailto:contact@seichiatlas.com">
          <Icon name="link" size={16} /> Email the project
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .prose { max-width: 68ch; }
  .prose h2 { margin: 2.4rem 0 0.8rem; font-size: 1.35rem; }
  .prose p { margin-bottom: 1.2rem; color: var(--text-muted); line-height: 1.7; }
  .prose ul { margin: 0 0 1.6rem; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; color: var(--text-muted); }
  .prose li::marker { color: var(--accent); }
</style>
