---
import Base from '../layouts/Base.astro';
import MapExplorer from '../components/MapExplorer.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { works, locations, appearances, stats } from '../lib/data';
import { locationsForWork, dayTripLocationsForWork, workCover } from '../lib/data';

const featured = [...works]
  .sort((a, b) => {
    const sa = stats.perWork[a.id];
    const sb = stats.perWork[b.id];
    return (sb?.total || 0) - (sa?.total || 0);
  })
  .slice(0, 6);

const totalConfirmed = appearances.filter((a) => a.confidence === 'confirmed').length;
---

<Base title="Anime pilgrimage, mapped">
  <section class="hero section section--paper">
    <div class="hero__mesh" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="micro hero__eyebrow">Independent seichi database · Kanto day-trip edition</p>
        <h1 class="display-xl hero__title">
          Every anime pilgrimage site,<br /><em>actually reachable.</em>
        </h1>
        <p class="lede hero__lede">
          Real locations from your favourite series: exact coordinates, travel time from Tokyo,
          and <strong>whether you can genuinely visit</strong>. No guesswork. Verified.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href="#explore">
            <Icon name="compass" size={18} /> Explore the map
          </a>
          <a class="btn btn--ghost btn--lg" href="/anime">
            Browse {stats.works} series
          </a>
        </div>
        <dl class="hero__stats">
          <div class="hero__stat">
            <dt class="display-lg mono">{stats.locations}</dt>
            <dd class="micro">mapped sites</dd>
          </div>
          <div class="hero__stat">
            <dt class="display-lg mono">{stats.works}</dt>
            <dd class="micro">series covered</dd>
          </div>
          <div class="hero__stat">
            <dt class="display-lg mono">{totalConfirmed}</dt>
            <dd class="micro">confirmed scenes</dd>
          </div>
        </dl>
      </div>

      <div class="hero__side">
        <div class="hero__card card">
          <div class="hero__card-head">
            <span class="micro">Featured</span>
            <span class="hero__card-note mono">verified {new Date().getFullYear()}</span>
          </div>
          <ul class="hero__list">
            {
              featured.map((w) => {
                const daytrip = dayTripLocationsForWork(w.id).length;
                const cover = workCover(w.id);
                return (
                  <li class="hero__item">
                    <a class="hero__item-link" href={`/anime/${w.slug}/`}>
                      {cover && <span class="hero__item-thumb"><img src={cover} alt="" loading="lazy" decoding="async" /></span>}
                      <span class="hero__item-txt">
                        <span class="hero__item-title">{w.title_en}</span>
                        <span class="hero__item-meta mono">
                          {stats.perWork[w.id]?.total || 0} sites · {daytrip} day-trip
                        </span>
                      </span>
                      <Icon name="chevron-right" size={16} />
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        <p class="hero__aside-note mono">
          Coordinates verified against public sources · last-checked date on every site
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight explorer-section" id="explore">
    <div class="container">
      <div class="explorer-section__head">
        <h2 class="display-lg">The atlas</h2>
        <p class="lede">
          Filter by series, travel time from Tokyo, prefecture, and whether you can actually walk in.
          Tap a pin for the essentials, or open a site for the full detail.
        </p>
      </div>
      <MapExplorer />
    </div>
  </section>

  <section class="section section--ink ethics">
    <div class="container ethics__grid">
      <div class="ethics__copy">
        <p class="micro" style="color:color-mix(in srgb, var(--paper) 55%, transparent);">A note on respect</p>
        <h2 class="display-lg">Go quietly. These are real neighbourhoods.</h2>
        <p class="lede" style="color:color-mix(in srgb, var(--paper) 78%, transparent);">
          The stairways, shrines and crossings on this map are someone's daily commute. Several
          famous sites have already been closed to visitors because of bad behaviour. Please follow
          posted etiquette, respect residents, and leave each place as you found it.
        </p>
        <a class="btn btn--dark" href="/about">Read our code of conduct</a>
      </div>
      <div class="ethics__rules">
        <div class="ethics__rule">
          <Icon name="pin" size={18} />
          <span><strong>Private homes aren't mapped</strong> to exact coordinates.</span>
        </div>
        <div class="ethics__rule">
          <Icon name="warning" size={18} />
          <span><strong>Closed sites stay on the map</strong> with a reason and date.</span>
        </div>
        <div class="ethics__rule">
          <Icon name="check" size={18} />
          <span><strong>Etiquette notes</strong> travel with every site.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--raised how">
    <div class="container">
      <h2 class="display-lg" style="max-width:16ch;">From series to street in three steps</h2>
      <div class="how__steps">
        <div class="how__step">
          <span class="how__num mono">01</span>
          <h3 class="display-md">Pick your series</h3>
          <p class="how__text">Search by English, Japanese, romaji, or streaming title. Every alias resolves.</p>
        </div>
        <div class="how__step">
          <span class="how__num mono">02</span>
          <h3 class="display-md">Set your day-trip radius</h3>
          <p class="how__text">Slide the time from Tokyo. Sites beyond your window drop off the map instantly.</p>
        </div>
        <div class="how__step">
          <span class="how__num mono">03</span>
          <h3 class="display-md">Go there, not just "there"</h3>
          <p class="how__text">Japanese addresses in copy-paste form, nearest station, and route export for the road.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="pref-grid">
        {
          [
            { id: 'tokyo', name: 'Tokyo', count: locations.filter((l) => l.prefecture === 'tokyo').length },
            { id: 'kanagawa', name: 'Kanagawa', count: locations.filter((l) => l.prefecture === 'kanagawa').length },
            { id: 'saitama', name: 'Saitama', count: locations.filter((l) => l.prefecture === 'saitama').length },
            { id: 'chiba', name: 'Chiba', count: locations.filter((l) => l.prefecture === 'chiba').length },
          ].map((p) => (
            <a class="pref-card" href={`/prefecture/${p.id}/`}>
              <span class="pref-card__name display-md">{p.name}</span>
              <span class="pref-card__count mono">{p.count} sites</span>
              <Icon name="arrow-up-right" size={18} />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--paper-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--paper-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 20%, black 20%, transparent 70%);
    opacity: 0.5;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__eyebrow { margin-bottom: 1.2rem; }
  .hero__title { margin-bottom: 1.2rem; }
  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }
  .hero__lede { margin-bottom: 1.8rem; }
  .hero__ctas { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 2.6rem; }

  .hero__stats { display: flex; gap: clamp(1.6rem, 4vw, 3.2rem); margin: 0; }
  .hero__stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .hero__stat dt { color: var(--text); font-size: 1.9rem; }
  .hero__stat dd { margin: 0; }

  .hero__side { display: flex; flex-direction: column; gap: 1rem; }
  .hero__card { overflow: hidden; }
  .hero__card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.2rem;
    border-bottom: 1px solid var(--paper-line);
  }
  .hero__card-note { font-size: 0.7rem; color: var(--text-faint); }
  .hero__list { list-style: none; margin: 0; padding: 0.4rem 1.2rem 1rem; }
  .hero__item { border-top: 1px solid var(--paper-line); }
  .hero__item:first-child { border-top: 0; }
  .hero__item-link {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 0.8rem;
    align-items: center;
    padding: 0.7rem 0;
    text-decoration: none;
    color: var(--text);
  }
  .hero__item-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-sunken);
    flex-shrink: 0;
  }
  .hero__item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__item-txt { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .hero__item-link:hover .hero__item-title { color: var(--accent); }
  .hero__item-title { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; transition: color 0.15s ease; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hero__item-meta { font-size: 0.7rem; color: var(--text-faint); }
  .hero__item-link svg { color: var(--text-faint); }
  .hero__aside-note { font-size: 0.7rem; color: var(--text-faint); text-align: center; }

  @media (max-width: 1023px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__side { order: -1; }
  }

  .explorer-section__head { max-width: 56ch; margin-bottom: 1.6rem; }
  .explorer-section__head h2 { margin-bottom: 0.6rem; }

  .ethics__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ethics__copy h2 { margin: 0.8rem 0 1rem; }
  .ethics__copy .lede { margin-bottom: 1.6rem; }
  .ethics__rules { display: flex; flex-direction: column; gap: 0.8rem; }
  .ethics__rule {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
    border-radius: var(--r-card);
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--paper) 85%, transparent);
  }
  .ethics__rule svg { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .ethics__rule strong { color: var(--paper); }
  @media (max-width: 900px) {
    .ethics__grid { grid-template-columns: 1fr; }
  }

  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
    margin-top: 2.2rem;
  }
  .how__step {
    padding: 1.6rem;
    border: 1px solid var(--paper-line);
    border-radius: var(--r-card);
    background: var(--paper);
  }
  .how__num { color: var(--accent); font-size: 0.85rem; }
  .how__step h3 { margin: 0.8rem 0 0.5rem; font-size: 1.15rem; }
  .how__text { color: var(--text-muted); font-size: 0.95rem; }
  @media (max-width: 900px) {
    .how__steps { grid-template-columns: 1fr; }
  }

  .pref-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .pref-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem;
    border: 1px solid var(--paper-line);
    border-radius: var(--r-card);
    background: var(--paper-raised);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pref-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pref-card svg { color: var(--accent); margin-top: 0.6rem; }
  .pref-card__count { font-size: 0.72rem; color: var(--text-faint); }
  @media (max-width: 900px) {
    .pref-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .pref-grid { grid-template-columns: 1fr; }
  }
</style>
