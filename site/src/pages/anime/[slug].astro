---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { workBySlug, locationsForWork, dayTripLocationsForWork, appearancesForWork, prefectureById, locations, photoFor, workCover } from '../../lib/data';

export function getStaticPaths() {
  return [...workBySlug.keys()].map((slug) => ({
    params: { slug },
    props: { work: workBySlug.get(slug) },
  }));
}

const { work } = Astro.props;
const locs = locationsForWork(work.id).sort((a, b) => a.name_en.localeCompare(b.name_en));
const daytrip = dayTripLocationsForWork(work.id);
const appr = appearancesForWork(work.id);
const confirmedCount = appr.filter((a) => a.confidence === 'confirmed').length;
const prefIds = [...new Set(locs.map((l) => l.prefecture))];
const prefs = prefIds.map((p) => prefectureById.get(p)?.name_en || p);
const aliases = work.aliases?.filter((a) => a.toLowerCase() !== work.title_en.toLowerCase());
const cover = workCover(work.id);

// Category breakdown
const catLabels: Record<string, string> = {
  station: 'Stations', shrine: 'Shrines & temples', school: 'Schools', shotengai: 'Shopping streets',
  shop: 'Shops', bridge: 'Bridges', crossing: 'Crossings', park: 'Parks', nature: 'Nature', other: 'Landmarks',
};
const catCount: Record<string, number> = {};
for (const l of locs) catCount[l.category] = (catCount[l.category] || 0) + 1;
const catEntries = Object.entries(catCount).sort((a, b) => b[1] - a[1]).slice(0, 4);

// Representative confirmed scenes (place + one-line scene note)
const repScenes = appr
  .filter((a) => a.confidence === 'confirmed')
  .slice(0, 6)
  .map((a) => ({ appr: a, loc: locations.find((l) => l.id === a.location_id)! }))
  .filter((x) => x.loc && x.appr.scene_note_en);

// Structured data (JSON-LD)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': work.type === 'film' ? 'Movie' : work.type === 'ova' ? 'Movie' : 'TVSeries',
  '@id': `https://seichi.antonbase.com/anime/${work.slug}/`,
  name: work.title_en,
  alternateName: [work.title_ja, work.title_romaji, ...(work.aliases || [])].filter(Boolean),
  url: `https://seichi.antonbase.com/anime/${work.slug}/`,
  ...(cover ? { image: `https://seichi.antonbase.com${cover}` } : {}),
  datePublished: String(work.year),
  ...(work.studio ? { productionCompany: { '@type': 'Organization', name: work.studio } } : {}),
  ...(work.official_url ? { sameAs: work.official_url } : {}),
  ...(work.mal_id ? { identifier: `myanimelist:${work.mal_id}` } : {}),
  about: locs.map((l) => ({
    '@type': 'TouristAttraction',
    '@id': `https://seichi.antonbase.com/location/${l.slug}/`,
    name: l.name_en,
  })),
};
---

<Base title={work.title_en} description={`All verified anime pilgrimage locations for ${work.title_en} (${work.title_ja}), with coordinates, travel time from Tokyo, and access notes.`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section section--paper">
    <div class="container">
      <a class="breadcrumb" href="/anime"><span>← All series</span></a>

      <div class="work-head">
        {cover && (
          <div class="work-head__cover">
            <img src={cover} alt={`${work.title_en} — a mapped location`} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="work-head__main">
          <p class="micro">Anime · {work.year} · {work.studio}</p>
          <h1 class="display-xl">{work.title_en}</h1>
          <p class="work-head__ja mono">{work.title_ja}</p>
          {aliases && aliases.length > 0 && (
            <p class="work-head__aliases mono">
              Also known as: {aliases.slice(0, 4).join(' · ')}
            </p>
          )}
          <p class="lede work-head__lede">
            {locs.length} mapped locations · {confirmedCount} confirmed · {daytrip.length} day-trip
            from Tokyo
          </p>
          <div class="work-head__links">
            {work.official_url && (
              <a class="btn btn--ghost btn--sm" href={work.official_url} target="_blank" rel="noopener">
                <Icon name="external" size={15} /> Official site
              </a>
            )}
            {work.mal_id && (
              <a class="btn btn--ghost btn--sm" href={`https://myanimelist.net/anime/${work.mal_id}`} target="_blank" rel="noopener">
                <Icon name="external" size={15} /> MyAnimeList
              </a>
            )}
            {work.anilist_id && (
              <a class="btn btn--ghost btn--sm" href={`https://anilist.co/anime/${work.anilist_id}`} target="_blank" rel="noopener">
                <Icon name="external" size={15} /> AniList
              </a>
            )}
          </div>
        </div>
      </div>

      {catEntries.length > 0 && (
        <div class="cat-strip">
          {catEntries.map(([cat, n]) => (
            <span class="cat-pill"><span class="cat-pill__n mono">{n}</span> {catLabels[cat] || cat}</span>
          ))}
        </div>
      )}

      {repScenes.length > 0 && (
        <div class="scenes">
          <h2 class="scenes__title display-md">Signature scenes</h2>
          <p class="scenes__sub mono">Confirmed on-screen appearances · one line each, no spoilers</p>
          <div class="scenes__grid">
            {repScenes.map(({ appr, loc }) => {
              const shot = photoFor(loc.id);
              return (
                <a class="scene-card" href={`/location/${loc.slug}/`}>
                  {shot && <div class="scene-card__media"><img src={shot} alt="" loading="lazy" decoding="async" /></div>}
                  <div class="scene-card__body">
                    <span class="scene-card__place">{loc.name_en}</span>
                    <span class="scene-card__note">{appr.scene_note_en}</span>
                    <span class="scene-card__go mono">View location →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <div class="pref-strip">
        <span class="micro">Prefectures</span>
        <div class="pref-strip__chips">
          {prefs.map((p) => <span class="badge">{p}</span>)}
        </div>
      </div>

      <div class="daytrip-banner">
        <Icon name="train" size={20} />
        <div>
          <strong>{daytrip.length} sites are reachable as a day trip from Tokyo</strong>
          <span class="mono daytrip-banner__sub">
            {daytrip.length > 0 ? 'open each site for the route and Japanese address' : 'all mapped sites are within reach'}
          </span>
        </div>
        {daytrip.length > 0 && (
          <a class="btn btn--primary btn--sm" href={`/anime/${work.slug}/day-trip/`}>View day-trip list</a>
        )}
      </div>

      <div class="loc-grid">
        {locs.map((l) => {
          const tf = l.travel_from?.tokyo;
          const vis = l.visitability;
          const cover = photoFor(l.id);
          return (
            <a class="loc-card" href={`/location/${l.slug}/`}>
              {cover && (
                <div class="loc-card__media">
                  <img class="loc-card__img" src={cover} alt="" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="loc-card__body">
                <div class="loc-card__head">
                  <span class="loc-card__name">{l.name_en}</span>
                  <span class={`badge badge--${vis}`}>{vis}</span>
                </div>
                <span class="loc-card__ja mono">{l.name_ja}</span>
                <div class="loc-card__meta mono">
                  {l.nearest_station?.name_en && <span><Icon name="train" size={13} /> {l.nearest_station.name_en}</span>}
                  {tf && <span><Icon name="clock" size={13} /> {tf.minutes} min from Tokyo</span>}
                </div>
                <div class="loc-card__foot">
                  <span class="loc-card__cat mono">{l.category}</span>
                  {l.entry_fee === 'paid' && <span class="badge">Paid entry</span>}
                  {l.car_required && <span class="badge">Car needed</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .breadcrumb {
    display: inline-block;
    margin-bottom: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb:hover { color: var(--accent); }

  .work-head {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    max-width: 100%;
  }
  .work-head__cover {
    aspect-ratio: 16 / 10;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--paper-line);
    box-shadow: var(--shadow-card);
    background: var(--paper-sunken);
  }
  .work-head__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .work-head__ja { color: var(--text-faint); font-size: 1rem; margin-top: 0.4rem; }
  .work-head__aliases { color: var(--text-faint); font-size: 0.75rem; margin-top: 0.6rem; }
  .work-head__lede { margin-top: 1.1rem; }
  .work-head__links { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.2rem; }
  @media (max-width: 720px) {
    .work-head { grid-template-columns: 1fr; }
  }

  .cat-strip { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 2rem 0 0.6rem; }
  .cat-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--paper-line);
    border-radius: var(--r-pill);
    background: var(--paper-raised);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .cat-pill__n { color: var(--accent); font-size: 1rem; font-weight: 600; }

  .scenes { margin: 1.8rem 0 2.4rem; }
  .scenes__title { font-size: 1.5rem; margin-bottom: 0.2rem; }
  .scenes__sub { font-size: 0.72rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .scenes__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  @media (max-width: 1023px) { .scenes__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .scenes__grid { grid-template-columns: 1fr; } }
  .scene-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--paper-line);
    border-radius: var(--r-card);
    background: var(--paper-raised);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .scene-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .scene-card__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--paper-sunken); }
  .scene-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .scene-card__body { display: flex; flex-direction: column; gap: 0.35rem; padding: 0.9rem 1rem; }
  .scene-card__place { font-family: var(--font-display); font-weight: 600; font-size: 1rem; }
  .scene-card__note { font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; }
  .scene-card__go { font-size: 0.72rem; color: var(--accent); margin-top: 0.3rem; }

  .pref-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.2rem 0 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--paper-line);
  }
  .pref-strip__chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .daytrip-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--r-card);
    margin-bottom: 2.2rem;
  }
  .daytrip-banner svg { color: var(--accent); flex-shrink: 0; }
  .daytrip-banner strong { font-family: var(--font-display); font-size: 1.02rem; }
  .daytrip-banner__sub { display: block; font-size: 0.72rem; color: var(--text-muted); margin-top: 0.15rem; }
  .daytrip-banner .btn { margin-left: auto; flex-shrink: 0; }
  @media (max-width: 640px) {
    .daytrip-banner { flex-wrap: wrap; }
    .daytrip-banner .btn { margin-left: 0; }
  }

  .loc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
  @media (max-width: 800px) { .loc-grid { grid-template-columns: 1fr; } }

  .loc-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    border: 1px solid var(--paper-line);
    border-radius: var(--r-card);
    background: var(--paper-raised);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .loc-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .loc-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-sunken);
  }
  .loc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .loc-card:hover .loc-card__img { transform: scale(1.03); }
  .loc-card__body { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.1rem 1.2rem; }
  .loc-card__head { display: flex; justify-content: space-between; gap: 0.6rem; align-items: center; }
  .loc-card__name { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; }
  .loc-card__ja { font-size: 0.75rem; color: var(--text-faint); }
  .loc-card__meta { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.72rem; color: var(--text-muted); margin-top: 0.3rem; }
  .loc-card__meta span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .loc-card__foot { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .loc-card__cat { font-size: 0.68rem; color: var(--text-faint); letter-spacing: 0.06em; text-transform: uppercase; }
</style>
