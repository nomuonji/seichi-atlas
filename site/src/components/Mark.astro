---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<!-- 印(じるし): vermilion map marker fused with a torii silhouette -->
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" role="img" aria-label="Seichi Atlas mark">
  <path d="M16 2c-5.8 0-10.5 4.6-10.5 10.3 0 7.3 10.5 17.7 10.5 17.7s10.5-10.4 10.5-17.7C26.5 6.6 21.8 2 16 2z" fill="var(--accent)"/>
  <circle cx="16" cy="12.5" r="4" fill="var(--paper)"/>
  <path d="M12 17.5l8-1" stroke="var(--paper)" stroke-width="1.6" stroke-linecap="round"/>
  <path d="M13 20l6-.8" stroke="var(--paper)" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
</svg>
